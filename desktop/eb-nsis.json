{
  "appId": "com.clawguard.desktop",
  "productName": "Clawguard",
  "artifactName": "Clawguard-${version}-${arch}.${ext}",
  "directories": {
    "output": "release-nsis",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/assets/**/*",
    "package.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Clawguard",
    "include": "build/installer.nsh"
  },
  "extraFiles": [
    {
      "from": "../terminal",
      "to": "terminal",
      "filter": [
        "**/*",
        "!**/.git/**",
        "!**/node_modules/**",
        "!**/__pycache__/**",
        "!**/.pytest_cache/**",
        "!**/runtime/**",
        "!**/*.log",
        "!**/configs/remote.json",
        "!**/*.bak",
        "!**/交接总结*"
      ]
    }
  ]
}

