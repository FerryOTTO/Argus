{
  "name": "argus-desktop",
  "version": "1.0.0",
  "description": "Argus AI Agent Security Guardian Desktop Client - MiMo Code Design System",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app:dev": "node scripts/dev.js",
    "package:win": "npm run build && electron-builder --win dir",
    "start:packaged": "electron-builder --win dir && .\\release\\win-unpacked\\Argus.exe",
    "package:exe": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "argus",
    "electron",
    "vue3",
    "mimo-ui",
    "ai-security"
  ],
  "author": "Argus Team",
  "license": "MIT",
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8"
  },
  "build": {
    "appId": "com.argus.desktop",
    "productName": "Argus",
    "artifactName": "Argus-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argus",
    "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "../terminal",
        "to": "terminal",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/node_modules/**",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!**/runtime/**",
          "!**/*.log",
          "!**/configs/remote.json",
          "!**/*.bak",
          "!**/交接总结*"
        ]
      }
    ]
  }
}

