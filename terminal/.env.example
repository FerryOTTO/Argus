ARGUS_CONFIG=configs/modules.yaml
ARGUS_POLICY=configs/policy.yaml

# Tool Guard 意图匹配裁判(LLM)
# 默认值可在 configs/modules.yaml 的 modules.tool_guard 段配置,
# 运行期可通过 PUT /v1/tool_guard/config 修改(仅内存生效)
TOOL_GUARD_LLM_BASE_URL=https://api.deepseek.com/v1
TOOL_GUARD_LLM_API_KEY=
TOOL_GUARD_LLM_MODEL=deepseek-chat
TOOL_GUARD_BLOCK_THRESHOLD=0.4
TOOL_GUARD_REVIEW_THRESHOLD=0.7
TOOL_GUARD_LLM_TIMEOUT=30
# Tool Guard 判定结果写审计日志(REST POST /v1/audit/event);留空不写入
TOOL_GUARD_AUDIT_API_URL=http://127.0.0.1:8000
