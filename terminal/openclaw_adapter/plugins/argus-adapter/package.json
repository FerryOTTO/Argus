{
  "name": "openclaw-argus-adapter-plugin",
  "version": "0.4.4",
  "description": "Unified Argus security hooks for OpenClaw.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11 <2027"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openclaw": "2026.6.11",
    "typescript": "^5.7.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    }
  }
}
