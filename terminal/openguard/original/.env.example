# OpenGuard Auth-Gateway 环境变量模板
# 复制为 .env 并填入实际值（本文件不含任何真实密钥）

# ========= OpenGuard Auth-Gateway =========
PORT=8001
ADMIN_USERNAME=admin
JWT_PRIVATE_KEY_PATH=jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_public.pem
# Bridge 共享密钥（自行生成随机值）
BRIDGE_TOKEN=your_bridge_token_here
BRIDGE_URL=ws://127.0.0.1:18080
BRIDGE_HTTP_URL=http://127.0.0.1:18080
OPENCLAW_URL=http://127.0.0.1:18789
CLAWGUARD_URL=http://127.0.0.1:8765
# LLM 代理共享密钥（自行生成随机值）
LLM_PROXY_TOKEN=your_llm_proxy_token_here

# ========= Provider Keys (fill manually) =========
LLM_API_KEY=
LLM_API_BASE=
HOSTED_VLLM_API_KEY=
HOSTED_VLLM_API_BASE=
CLAUDE_API_KEY=
CLAUDE_API_BASE=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
BAICHUAN_API_KEY=
DOUBAO_API_KEY=
YI_API_KEY=
STEPFUN_API_KEY=
HUNYUAN_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
